# Database (Neon / Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/ieb_demo?sslmode=require"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Storage (optional for demo - document metadata only)
STORAGE_URL="https://your-bucket.example.com"
STORAGE_KEY="your-storage-key"

# App
NODE_ENV="development"
CORS_ORIGIN="*"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Demo Admin (seeded)
DEMO_ADMIN_EMAIL="admin@ieb-demo.local"
DEMO_ADMIN_PASSWORD="ChangeMe123!"
